  <step>
    <name>Faltantes y control</name>
    <type>Formula</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>viajeros_esp</field_name>
      <formula_string>IF(AND(ISBLANK([v_esp]);NOT(ISBLANK([v_ext]));NOT(ISBLANK([v_tot])));[v_tot]-[v_ext];[v_esp])</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>pernoctaciones_esp</field_name>
      <formula_string>IF(AND(ISBLANK([p_esp]);NOT(ISBLANK([p_ext]));NOT(ISBLANK([p_tot])));[p_tot]-[p_ext];[p_esp])</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>viajeros_ext</field_name>
      <formula_string>IF(AND(ISBLANK([v_ext]);NOT(ISBLANK([v_esp]));NOT(ISBLANK([v_tot])));[v_tot]-[v_esp];[v_ext])</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>pernoctaciones_ext</field_name>
      <formula_string>IF(AND(ISBLANK([p_ext]);NOT(ISBLANK([p_esp]));NOT(ISBLANK([p_tot])));[p_tot]-[p_esp];[p_ext])</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>imp_esp</field_name>
      <formula_string>IF(OR(AND(ISBLANK([v_esp]);NOT(ISBLANK([v_ext]));NOT(ISBLANK([v_tot])));AND(ISBLANK([p_esp]);NOT(ISBLANK([p_ext]));NOT(ISBLANK([p_tot]))));1;0)</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>imp_ext</field_name>
      <formula_string>IF(OR(AND(ISBLANK([v_ext]);NOT(ISBLANK([v_esp]));NOT(ISBLANK([v_tot])));AND(ISBLANK([p_ext]);NOT(ISBLANK([p_esp]));NOT(ISBLANK([p_tot]))));1;0)</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>dif_viajeros</field_name>
      <formula_string>IF(AND(NOT(ISBLANK([v_tot]));NOT(ISBLANK([v_esp]));NOT(ISBLANK([v_ext])));IF(ABS([v_tot]-[v_esp]-[v_ext])>1;1;0);0)</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>dif_pernoctaciones</field_name>
      <formula_string>IF(AND(NOT(ISBLANK([p_tot]));NOT(ISBLANK([p_esp]));NOT(ISBLANK([p_ext])));IF(ABS([p_tot]-[p_esp]-[p_ext])>1;1;0);0)</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
