    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>turismo_dw</connection>
    <sql>SELECT COUNT(*) AS n_estancia
FROM turismo_dw.fact_ocupacion
WHERE (estancia_media IS NOT NULL AND (estancia_media &lt; 1 OR estancia_media > 30))
   OR (estancia_media IS NULL AND nivel_key &lt;&gt; 4);</sql>
