  <step>
    <name>Leer hechos y calcular motivos</name>
    <type>TableInput</type>
    <description>Lee la tabla de hechos y concatena todos los motivos de invalidez de cada fila.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>turismo_dw</connection>
    <sql>SELECT r.*,
       CASE WHEN r.motivo_eliminacion &lt;&gt; '' THEN 1 ELSE 0 END AS descartar
FROM (
  SELECT
    DATE_FORMAT(NOW(), '%Y-%m-%d %H:%i:%s') AS fecha_validacion,
    f.tiempo_key, f.ccaa_key, f.tipo_key, f.origen_key,
    f.nivel_key, f.calidad_key, f.viajeros,
    f.pernoctaciones, f.estancia_media,
    CONCAT_WS(' | ',
    IF((t.tiempo_key IS NULL OR c.ccaa_key IS NULL OR a.tipo_key IS NULL OR o.origen_key IS NULL OR ne.nivel_key IS NULL OR q.calidad_key IS NULL), 'Falta una clave en alguna dimensión', NULL),
    IF((f.viajeros &lt; 0 OR f.pernoctaciones &lt; 0), 'Viajeros o pernoctaciones negativos', NULL),
    IF((f.viajeros IS NOT NULL AND f.pernoctaciones IS NOT NULL AND f.pernoctaciones &lt; f.viajeros), 'Pernoctaciones menores que viajeros', NULL),
    IF((f.viajeros = 0 AND f.pernoctaciones > 0), 'Pernoctaciones positivas con cero viajeros', NULL),
    IF((f.estancia_media IS NOT NULL AND (f.estancia_media &lt; 1 OR f.estancia_media > 30)), 'Estancia media fuera de 1 a 30 días', NULL),
    IF(((f.estancia_media IS NULL AND f.nivel_key &lt;&gt; 4)
      OR (f.estancia_media IS NOT NULL AND (
           f.nivel_key = 4
        OR (f.estancia_media &lt; 2 AND f.nivel_key &lt;&gt; 1)
        OR (f.estancia_media >= 2 AND f.estancia_media &lt; 4 AND f.nivel_key &lt;&gt; 2)
        OR (f.estancia_media >= 4 AND f.nivel_key &lt;&gt; 3)))), 'Nivel de estancia no coincide con la estancia media', NULL),
    IF(((f.estancia_media IS NOT NULL AND (f.viajeros IS NULL OR f.viajeros = 0 OR f.pernoctaciones IS NULL))
       OR (f.viajeros > 0 AND f.pernoctaciones IS NOT NULL AND (
            f.estancia_media IS NULL
            OR ABS(f.estancia_media - ROUND(f.pernoctaciones / f.viajeros, 2)) > 0.02))), 'Estancia media no coincide con pernoctaciones/viajeros', NULL)
    ) AS motivo_eliminacion
  FROM turismo_dw.fact_ocupacion AS f
  LEFT JOIN turismo_dw.dim_tiempo AS t ON f.tiempo_key = t.tiempo_key
  LEFT JOIN turismo_dw.dim_ccaa AS c ON f.ccaa_key = c.ccaa_key
  LEFT JOIN turismo_dw.dim_tipo_alojamiento AS a ON f.tipo_key = a.tipo_key
  LEFT JOIN turismo_dw.dim_origen AS o ON f.origen_key = o.origen_key
  LEFT JOIN turismo_dw.dim_nivel_estancia AS ne ON f.nivel_key = ne.nivel_key
  LEFT JOIN turismo_dw.dim_calidad_dato AS q ON f.calidad_key = q.calidad_key
) AS r</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
