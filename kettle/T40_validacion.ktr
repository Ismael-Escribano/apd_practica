  <step>
    <name>Comprobar BD después del borrado</name>
    <type>TableInput</type>
    <description>SELECT consolidado C1-C6, activado una sola vez al terminar los DELETE; incorpora contador de registros excluidos.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>turismo_dw</connection>
    <sql>SELECT
  (SELECT COUNT(*) 
FROM turismo_dw.fact_ocupacion f
LEFT JOIN turismo_dw.dim_tiempo t           ON t.tiempo_key  = f.tiempo_key
LEFT JOIN turismo_dw.dim_ccaa c             ON c.ccaa_key    = f.ccaa_key
LEFT JOIN turismo_dw.dim_tipo_alojamiento a ON a.tipo_key    = f.tipo_key
LEFT JOIN turismo_dw.dim_origen o           ON o.origen_key  = f.origen_key
LEFT JOIN turismo_dw.dim_nivel_estancia ne  ON ne.nivel_key  = f.nivel_key
LEFT JOIN turismo_dw.dim_calidad_dato q     ON q.calidad_key = f.calidad_key
WHERE t.tiempo_key IS NULL
   OR c.ccaa_key IS NULL
   OR a.tipo_key IS NULL
   OR o.origen_key IS NULL
   OR ne.nivel_key IS NULL
   OR q.calidad_key IS NULL) AS n_huerfanas,
  (SELECT COUNT(*) 
FROM turismo_dw.fact_ocupacion
WHERE viajeros &lt; 0 OR pernoctaciones &lt; 0) AS n_negativos,
  (SELECT COUNT(*) 
FROM turismo_dw.fact_ocupacion
WHERE (viajeros IS NOT NULL AND pernoctaciones IS NOT NULL AND pernoctaciones &lt; viajeros)
   OR (viajeros = 0 AND pernoctaciones > 0)) AS n_coherencia,
  (SELECT COUNT(*) 
FROM turismo_dw.fact_ocupacion AS f
WHERE (f.estancia_media IS NOT NULL AND (f.estancia_media &lt; 1 OR f.estancia_media > 30))
   OR (f.estancia_media IS NULL AND f.nivel_key &lt;&gt; 4)
   OR (f.estancia_media IS NOT NULL AND (
          f.nivel_key = 4
       OR (f.estancia_media &lt; 2 AND f.nivel_key &lt;&gt; 1)
       OR (f.estancia_media >= 2 AND f.estancia_media &lt; 4 AND f.nivel_key &lt;&gt; 2)
       OR (f.estancia_media >= 4 AND f.nivel_key &lt;&gt; 3)))
   OR (f.estancia_media IS NOT NULL AND (
          f.viajeros IS NULL OR f.viajeros = 0 OR f.pernoctaciones IS NULL))
   OR (f.viajeros > 0 AND f.pernoctaciones IS NOT NULL AND (
          f.estancia_media IS NULL
       OR ABS(f.estancia_media - ROUND(f.pernoctaciones / f.viajeros, 2)) > 0.02))) AS n_estancia,
  (SELECT COUNT(*) 
FROM (
    SELECT tiempo_key, ccaa_key, tipo_key, origen_key
    FROM turismo_dw.fact_ocupacion
    GROUP BY tiempo_key, ccaa_key, tipo_key, origen_key
    HAVING COUNT(*) > 1
) duplicados) AS n_grano,
  (SELECT ABS((SELECT COUNT(*) FROM turismo_dw.dim_tiempo) - 120) +
       ABS((SELECT COUNT(*) FROM turismo_dw.dim_ccaa) - 19) +
       ABS((SELECT COUNT(*) FROM turismo_dw.fact_ocupacion) - 18240) ) AS n_volumen,
  CAST(COALESCE(?, 0) AS SIGNED) AS n_eliminadas;</sql>
    <limit>0</limit>
    <lookup>Esperar fin del borrado y contar</lookup>
    <execute_each_row>Y</execute_each_row>
