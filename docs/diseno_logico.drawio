        <mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;PK: clave primaria · FK: clave ajena · UK: clave única&lt;br&gt;M: medida (fila resaltada) · dim_*: dimensión · fact_*: hechos&lt;br&gt;Población y patrimonio (BIC) son atributos de dim_ccaa." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
